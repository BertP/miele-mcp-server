NODE_ENV=development
PORT=8089

MIELE_CLIENT_ID=
MIELE_CLIENT_SECRET=
MIELE_REDIRECT_URI=https://your-domain.example.com/auth/callback

MIELE_AUTH_URL=https://auth.domestic.miele-iot.com/partner/realms/mcs/protocol/openid-connect/auth
MIELE_TOKEN_URL=https://auth.domestic.miele-iot.com/partner/realms/mcs/protocol/openid-connect/token
MIELE_API_BASE_URL=

MIELE_SCOPES="openid mcs_thirdparty_read mcs_thirdparty_media mcs_thirdparty_write"

DATABASE_PATH=./data/miele-mcp.sqlite

# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Generate with: openssl rand -hex 32
MCP_API_TOKEN=

LOG_LEVEL=info
